# ====================================================================
# ApexCrypto Pro Trading Platform - Environment Configuration
# ====================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=apex-crypto-jwt-auth-secret-key-32b!
ENCRYPTION_KEY=apex-crypto-ultra-secure-key-32b!

# Database Configuration
# Default uses embedded PGlite WASM (zero config required)
# Set to 'true' if you want local file persistence in ./data/pglite
PERSIST_DB=false
# Optional: External PostgreSQL connection string (e.g., Render Postgres / Supabase / Neon)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Optional Frontend API URL (leave empty when running unified backend + frontend on same port)
# VITE_API_URL=
# VITE_WS_URL=

# Optional: Binance Trading Credentials (For automated live/testnet orders)
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_TESTNET=false

# Optional: Telegram Alerts
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Optional: Coinglass API Key
# COINGLASS_API_KEY=
